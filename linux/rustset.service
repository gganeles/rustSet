# Installed by linux/install.sh as /etc/systemd/system/rustset.service.
[Unit]
Description=rustSet game server
Documentation=https://github.com/gganeles/rustSet
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
DynamicUser=yes
Environment=VIRTUAL_ENV=/usr/local/lib/rustset/venv
Environment=RUSTSET_ADDR=127.0.0.1:3030
Environment=PYTHONDONTWRITEBYTECODE=1
# Overrides for the settings above, e.g. RUSTSET_ADDR=0.0.0.0:3030
EnvironmentFile=-/etc/rustset/env
ExecStart=/usr/local/bin/rustset-server
Restart=always
RestartSec=5

# If it ever leaks memory, only this service is killed and restarted, not the machine.
MemoryMax=2G

# Hardening: the server needs no files of its own, only the network.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
